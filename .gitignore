# Python virtualenvs
**/.venv/
# Allow Python files in RAGservicer
!projects/ragservicer/*.py
!projects/ragservicer/**/*.py
# Allow Python files in Data (FastAPI)
!projects/data/*.py
!projects/data/**/*.py
# Allow Python files in Knowledge Injector
!projects/knowledge-injector/*.py
!projects/knowledge-injector/**/*.py
# Allow Python files in ML Service (FastAPI)
!projects/ml-service/*.py
!projects/ml-service/**/*.py
# Allow Python files in Shared (app_auth 统一鉴权契约，单来源)
!projects/shared/*.py
!projects/shared/**/*.py
