systemd_deploy.py
systemd_v2.py
systemd_mcp.py

# Sensitive deploy overrides (use .template versions)
deploy/overrides/*.conf
!deploy/overrides/templates/

# Local secrets
.env.github
~/.git-credentials

# Legacy server backups (contains private keys / tokens, never commit)
legacy/

# Python build artifacts
*.egg-info/

