[Unit]
Description=InfraX RAGservicer (:9721)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/infraX-1/projects/ragservicer
ExecStart=/home/ubuntu/infraX-1/projects/ragservicer/.venv/bin/python main.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
