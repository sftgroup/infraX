[Unit]
Description=InfraX hub-index — unified MCP entry (G-5 / 9.6 Phase 2.4)
After=network.target infrax-data.service infrax-knowledge-injector.service infrax-ragservicer.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/infraX-1/projects/mcp-server
Environment="PORT=3008"
Environment="DATA_URL=http://localhost:9112"
Environment="INJECTOR_URL=http://localhost:9113"
Environment="RAG_URL=http://localhost:9721"
# 密钥经部署脚本写入（DATA_API_KEY / INJECTOR_API_KEY / RAG_API_KEY，
# 对应四服务 bridge key；不 commit 明文，见 deploy/systemd 部署备注）
ExecStart=/home/ubuntu/infraX-1/projects/mcp-server/node_modules/.bin/tsx src/hub-index.ts
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
