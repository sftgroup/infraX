[Unit]
Description=InfraX infrax-mpc
After=network.target postgresql.service infrax-mpc-tss-signer.service infrax-mpc-signer.service infrax-chain-rpc.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/infraX/projects/mpc
Environment="MPC_ENCRYPTION_SECRET=2cca2225961a0b6e4edf2979f102d2e9de0b5531d4a2443e30a3bf8097b352a4"
Environment="ADMIN_PASS=a87cefd6e1ce487334a67b0c"
Environment="ADMIN_USER=admin"
# M3：TSS 签名器（片2 在 tss_signer 进程，服务端仅持片1）
Environment="MPC_SIGNER_URL=http://127.0.0.1:9201"
Environment="TSS_SIGNER_URL=http://127.0.0.1:9200"
# DC-3：链上访问统一经 chain-rpc 网关（key 需与 infrax-chain-rpc.service 一致，勿提交真实密钥）
Environment="CHAIN_RPC_URL=http://127.0.0.1:9130"
Environment="CHAIN_RPC_READ_KEY=CHANGE_ME_READ_KEY"
Environment="CHAIN_RPC_BROADCAST_KEY=CHANGE_ME_BROADCAST_KEY"
Environment="PORT=9104"
Environment="DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pocketx_mpc"
Environment="PATH=/usr/bin:/usr/local/bin:/home/ubuntu/.npm-global/bin:/opt/infraX/projects/mpc/node_modules/.bin:$PATH"
ExecStart=/usr/bin/tsx server.ts
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
