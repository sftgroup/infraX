# InfraX Knowledge Injector — 知识图谱注入微服务配置（:9113）
# 复制为 .env 并修改实际值。不要提交 .env 到 git。

# ── RAGservicer（InfraX LightRAG 微服务）──────────────
# 兼容回退链：RAGSERVICER_URL → DOC_URL → LIGHTRAG_URL
RAGSERVICER_URL=http://127.0.0.1:9721
# RAGservicer 内部桥接鉴权 key（对应 ragservicer 的 RAGSERVICER_API_KEY）
RAGSERVICER_API_KEY=
# 默认注入 namespace（默认 market；链上数据走 onchain）
# DEFAULT_NAMESPACE=market

# ── DC / Collector 数据源（raw data 配置化注入）──────
# DC 链上事件（infrax_dc provider）
# DC_URL=http://127.0.0.1:9102
# DC_API_KEY=
# Collector 市场信号（infrax_collector provider）
# COLLECTOR_URL=http://127.0.0.1:9101
# COLLECTOR_API_KEY=

# ── 注入调度 ────────────────────────────────────────────
INJECTOR_INTERVAL_SEC=21600
INJECTOR_STARTUP_DELAY=120

# ── API 服务 ────────────────────────────────────────────
# python main.py --api --port 9113 时生效
HOST=0.0.0.0
PORT=9113

# ── 管理后台鉴权（GET/PUT /admin/config 需 Bearer ADMIN_API_KEY）────
# ADMIN_API_KEY=change-me

# ── ml-service 联动（Kronos 波动率预测，已拆分独立服务）──
# 未配置则注入器跳过 ML 波动率预测（fail-silent）。
# ML_SERVICE_URL=http://<ml-server>:9120
# ML_API_KEY=                 # ml-service 自身鉴权（若配置了则必填）

# ── 业务端点鉴权（/inject/*、/query、/status、/stats 等）──────────
# 要求 Authorization: Bearer 或 X-API-Key 匹配；未设置时回退到上面的
# RAGSERVICER_API_KEY；都不配置则保持开放（兼容模式）。
# INJECTOR_API_KEY=

# ── API Keys（空 = 跳过对应数据源）────────────────────
# 可通过管理后台「Data Stack → 数据源 API Key」热更新，无需重启。
# FRED_API_KEY=            # 美国/全球宏观（跳过 = 宏观注入缺失）
# ETHERSCAN_API_KEY=       # ETH 供应/燃烧（跳过 = EVM 注入降级，仅质押段）
# FINNHUB_API_KEY=         # 新闻情感/财报指数/重大事件回退
# TUSHARE_API_KEY=         # 中国宏观（CPI/GDP/PPI/M2/PMI）
# NEWSAPI_KEY=             # 重大事件检测（未设置时回退 Finnhub）

# ── 数据库 ──────────────────────────────────────────────
# INJECT_DB_PATH=data/injector.db
