# ── Service ──
PORT=3000
NODE_ENV=production

# ── Database ──
# EPF-4（2026-08-22）：统一到 collector 实际使用的 PG 实例（10.3.8.6:5432），
# 与 systemd Environment 保持一致。注意 dotenv 不覆盖已存在环境变量，
# systemd Environment 优先——此处仅作为文件级配置与文档化的唯一事实源。
DATABASE_URL=postgresql://postgres:postgres@10.3.8.6:5432/pocketx_collector

# ── Admin Panel Auth ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=pocketx123

# ── JWT ──
JWT_SECRET=collector-jwt-secret-prod-2026
JWT_REFRESH_SECRET=collector-refresh-secret-prod-2026
CWALLET_API_KEY=collector-cwallet-key

# ── RPC Endpoints (7 chains, multi-key) ──
# Sepolia (testnet)
SEPOLIA_RPC_URL=https://sepolia.gateway.tenderly.co
SEPOLIA_RPC_URL_2=https://ethereum-sepolia-rpc.publicnode.com

# Ethereum
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
ETH_RPC_URL_2=https://1rpc.io/eth

# BSC
BSC_RPC_URL=https://bsc-rpc.publicnode.com
BSC_RPC_URL_2=https://1rpc.io/bnb

# Base
BASE_RPC_URL=https://base-rpc.publicnode.com
BASE_RPC_URL_2=https://1rpc.io/base

# ── Logging ──
LOG_LEVEL=info

# ── CORS ──
CORS_ORIGIN=*
