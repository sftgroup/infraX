# 生产环境变量模板 —— collector（InfraX）
#
# 用法：
#   - 本文件不含任何密钥，仅供部署参考与变量清单核对。
#   - 生产敏感密钥统一由 systemd drop-in 提供（EPF-8，2026-08-22）：
#       /etc/systemd/system/infrax-collector.service.d/secrets.conf   (root:600)
#   - dotenv 不覆盖已存在的环境变量 → systemd Environment 优先于本文件。
#
# 敏感项（全部在 secrets.conf，勿写入 .env / .env.production）：
#   DATABASE_URL        postgresql://pocketx_app:<pwd>@10.3.8.6:5432/pocketx_collector
#   ADMIN_USERNAME      admin
#   ADMIN_PASSWORD      <强随机 24+ 字符>
#   CWALLET_API_KEY     <64 hex>

# ── Service ──
PORT=9101
NODE_ENV=production

# ── RPC Endpoints（7 chains, multi-key；生产以 systemd 值为准）──
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
BASE_RPC_URL=https://mainnet.base.org
OXA_RPC_URL=https://rpc.l1.oxachain.io

# ── Logging ──
LOG_LEVEL=info

# ── CORS ──
CORS_ORIGIN=*

# ── 保留窗口 / 分区（默认即可）──
# PARTITION_HORIZON_DAYS=6
