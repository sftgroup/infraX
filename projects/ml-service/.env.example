# ml-service — 独立模型推理服务配置
# 复制为 .env 并修改实际值。不要提交 .env 到 git。

# ── 服务 ────────────────────────────────────────────────
ML_SERVICE_PORT=9120
LOG_LEVEL=INFO

# ── data-service 联动（K线/符号清单来源，必填） ────────
# DATA_SERVICE_URL=http://43.163.105.172:9112
# data-service 业务端点鉴权（与 data-service DATA_API_KEY 同一把）
# DATA_API_KEY=

# ── 目标符号池 / 端点缓存 / 异步预热 ────────────────────
# 目标符号池（逗号分隔；空则从 data-service /symbols 动态拉取，默认 1d≥120 根）
# P2_TARGET_SYMBOLS=BTC/USDT,ETH/USDT,SPY,AAPL,EURUSD=X
# 端点结果缓存时长（秒），TTL 内命中秒回不重算
# ML_CACHE_TTL_SEC=1800
# 预热线程：缓存缺失/过期时后台刷新，保证缓存常满；interval 建议 < TTL
# ML_PREWARM_ENABLED=true
# ML_PREWARM_DELAY_SEC=60
# ML_PREWARM_INTERVAL_SEC=900

# ── ml-service 自身鉴权（可选，内网部署建议配置） ──────
# 收敛为平台 bridge key（RAGSERVICER_API_KEY → DOC_API_KEY →
# LIGHTRAG_API_KEY 回退链，统一契约见 projects/shared/app_auth.py）；
# 客户端携带 Bearer / X-API-Key / X-Service-Key 任一。
# ML_API_KEY=change-me

# ── LightGBM 方向预测 ───────────────────────────────────
# TREE_ML_ENABLED=true
# TREE_ML_HORIZON=7
# TREE_ML_UP_THR=0.01
# TREE_ML_MIN_SAMPLES=300
# TREE_ML_MIN_BARS=120
# TREE_ML_MAX_BARS=2000
# TREE_ML_RETRAIN_HOURS=24
# TREE_ML_MODEL_DIR=models/

# ── XGBoost / Random Forest 方向预测（P1 对比家族）────────
# 与 LightGBM 同数据集/同切分训练作对照；RF 用 sklearn 自带
# XGB_ENABLED=true
# RF_ENABLED=true

# ── FinBERT 文本情绪 ────────────────────────────────────
# FINBERT_ENABLED=true
# FINBERT_MODEL=ProsusAI/finbert

# ── Kronos 波动率 ───────────────────────────────────────
# KRONOS_ENABLED=true
# KRONOS_MODEL=NeoQuasar/Kronos-mini
# KRONOS_LOOKBACK=400
# KRONOS_PRED_LEN=30
# KRONOS_SAMPLE_COUNT=12

# ── P2 时序基础模型（懒加载错峰，默认关闭）──────────────
# Chronos-Bolt：单变量概率基线（快速分位数，交叉验证用）
# BOLT_ENABLED=true
# BOLT_MODEL=amazon/chronos-bolt-small
# BOLT_CONTEXT=512
# BOLT_PRED_LEN=30
# BOLT_QUANTILES=0.1,0.5,0.9

# Moirai 2.0：多变量跨资产联动（全部资产一批喂入）
# MOIRAI_ENABLED=true
# MOIRAI_MODEL=Salesforce/moirai-2.0-R-small
# MOIRAI_CONTEXT=512
# MOIRAI_PRED_LEN=30
# MOIRAI_PATCH_SIZE=32

# TimesFM 2.5：长上下文点预测 + 置信区间（200m pytorch 版）
# TIMESFM_ENABLED=true
# TIMESFM_MODEL=google/timesfm-2.5-200m-pytorch
# TIMESFM_CONTEXT=1024
# TIMESFM_PRED_LEN=30

# ── 因子工厂定时挖掘（需求6 FF-4.1/FF-4.2） ────────────────
# 进程内 daemon 线程，interval 下限 1h；spec 来源优先级：
#   MULTI（多市场，每市场独立阈值）→ INTENT（自然语言 → LLM 解析）→ SPEC（JSON）
# FACTOR_MINER_SCHEDULE_ENABLED=true
# FACTOR_MINER_SCHEDULE_INTERVAL_H=6
# FACTOR_MINER_SCHEDULE_DELAY_S=60
# 多市场（FF-4.2）：JSON 数组，每市场独立 preferences/constraints/formulas，
# 阈值按市场数据特性单独配（crypto 短样本 ICIR 需低阈值，美股/外汇可高阈值）
# FACTOR_MINER_SCHEDULE_MULTI=[{"name":"crypto","preferences":{"factor_styles":["momentum","volatility"],"asset_pool":["BTC/USDT","ETH/USDT"]},"constraints":{"min_ic":0.03,"min_icir":0.05,"max_factors":20,"max_targets":10,"max_runtime_min":30},"formulas":["close.pct_change().rolling(20).std()"]},{"name":"us_stock","preferences":{"factor_styles":["momentum","volatility"],"asset_pool":["SPY","QQQ","AAPL"]},"constraints":{"min_ic":0.03,"min_icir":0.2,"max_factors":20,"max_targets":10,"max_runtime_min":30}}]
# INTENT（单市场回退）：自然语言 → LLM 解析，可自动生成 formulas
# FACTOR_MINER_SCHEDULE_INTENT=自动挖掘新因子：基于动量、波动率和成交量设计创新因子公式，市场类型 crypto，日线周期
# FACTOR_MINER_SCHEDULE_SPEC={"preferences":{},"constraints":{}}
# IC/ICIR 合格门槛（仅 INTENT 分支强制覆盖 LLM 解析值）：改这两个数字重启即生效。
# 联合门槛需同时满足；crypto 日线短样本下 IC 与 ICIR 此消彼长，建议 ICIR 门槛低于 IC
# FACTOR_MINER_SCHEDULE_MIN_IC=0.03
# FACTOR_MINER_SCHEDULE_MIN_ICIR=0.3
# 自动闭环（FF-4.3）：任务 COMPLETED 后 passed 因子自动激活（进 /factors/current
# 与模型特征）+ 置模型过期（下次预测自动重训）。默认开启，全链路无需人工
# FACTOR_MINER_AUTO_ACTIVATE=true
# FACTOR_MINER_AUTO_RETRAIN=true
