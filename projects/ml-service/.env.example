# ml-service — 独立模型推理服务配置
# 复制为 .env 并修改实际值。不要提交 .env 到 git。

# ── 服务 ────────────────────────────────────────────────
ML_SERVICE_PORT=9120
LOG_LEVEL=INFO

# ── data-service 联动（K线/符号清单来源，必填） ────────
# DATA_SERVICE_URL=http://43.163.105.172:9112
# data-service 业务端点鉴权（与 data-service DATA_API_KEY 同一把）
# DATA_API_KEY=

# ── ml-service 自身鉴权（可选，内网部署建议配置） ──────
# ML_API_KEY=change-me

# ── LightGBM 方向预测 ───────────────────────────────────
# TREE_ML_ENABLED=true
# TREE_ML_HORIZON=7
# TREE_ML_UP_THR=0.01
# TREE_ML_MIN_SAMPLES=300
# TREE_ML_MIN_BARS=120
# TREE_ML_MAX_BARS=2000
# TREE_ML_RETRAIN_HOURS=24
# TREE_ML_MODEL_DIR=models/

# ── XGBoost / Random Forest 方向预测（P1 对比家族）────────
# 与 LightGBM 同数据集/同切分训练作对照；RF 用 sklearn 自带
# XGB_ENABLED=true
# RF_ENABLED=true

# ── FinBERT 文本情绪 ────────────────────────────────────
# FINBERT_ENABLED=true
# FINBERT_MODEL=ProsusAI/finbert

# ── Kronos 波动率 ───────────────────────────────────────
# KRONOS_ENABLED=true
# KRONOS_MODEL=NeoQuasar/Kronos-mini
# KRONOS_LOOKBACK=400
# KRONOS_PRED_LEN=30
# KRONOS_SAMPLE_COUNT=12

# ── P2 时序基础模型（懒加载错峰，默认关闭）──────────────
# Chronos-Bolt：单变量概率基线（快速分位数，交叉验证用）
# BOLT_ENABLED=true
# BOLT_MODEL=amazon/chronos-bolt-small
# BOLT_CONTEXT=512
# BOLT_PRED_LEN=30
# BOLT_QUANTILES=0.1,0.5,0.9

# Moirai 2.0：多变量跨资产联动（全部资产一批喂入）
# MOIRAI_ENABLED=true
# MOIRAI_MODEL=Salesforce/moirai-2.0-R-small
# MOIRAI_CONTEXT=512
# MOIRAI_PRED_LEN=30
# MOIRAI_PATCH_SIZE=32

# TimesFM 2.5：长上下文点预测 + 置信区间（200m pytorch 版）
# TIMESFM_ENABLED=true
# TIMESFM_MODEL=google/timesfm-2.5-200m-pytorch
# TIMESFM_CONTEXT=1024
# TIMESFM_PRED_LEN=30
