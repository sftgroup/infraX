# ============================================================
# InfraX 通用支付引擎 — B 端实例 env 配置模板
# 生成日期: 2026-08-11 | 适用: @0xinfrax/payments 独立服务形态（server.ts）
# 接入模式: 独立实例 + 自配凭证（一个实例 = 一套收款，钱进 B 端自己的账户）
# 完整接入文档: projects/payments/CALLER_SETUP.md | 部署步骤: projects/payments/DEPLOY.md
# 使用: 复制为 .env（或写入 systemd Environment=），填好必填项后启动
# ============================================================

# ── 基础（必填）────────────────────────────────────────────────
PORT=9132
DATABASE_URL=postgresql://user:pass@host:5432/pocketx_payments   # B端自己的库（迁移 001-006 启动时自动执行）
PAYMENTS_API_KEY=<随机 hex，服务间调用 key>                        # 生成: openssl rand -hex 24

# 可选：mx_ 前缀 key 实时校验（对齐平台 /api-keys/verify；不配则仅 PAYMENTS_API_KEY 白名单）
# DATA_URL=http://127.0.0.1:9112
# DATA_API_KEY=<data 服务 bridge key>

# ── 收款① chain 轨（必填至少一条；RPC_URL/CHAIN_ID/SUBSCRIPTION_MANAGER 三件套缺一即启动失败） ──
CHAIN_OXACHAIN_RPC_URL=http://127.0.0.1:9130/v1/rpc/oxa          # 或 B端自备直连 RPC
CHAIN_OXACHAIN_CHAIN_ID=19505
CHAIN_OXACHAIN_SUBSCRIPTION_MANAGER=0x<B端自己的收款合约地址>
# 多链同构：CHAIN_<NAME>_RPC_URL / CHAIN_<NAME>_CHAIN_ID / CHAIN_<NAME>_SUBSCRIPTION_MANAGER
#   NAME ∈ OXACHAIN | SEPOLIA | POLYGON | BASE
# 可选：经 chain-rpc 网关读 RPC（自动带 X-Service-Key 读 key + raw JSON-RPC）
# CHAIN_RPC_READ_KEY=<chain-rpc 网关读 key>

# ── 收款② fiat 轨（可选；不配则 /payments/checkout 返回 503） ──
# STRIPE_SECRET_KEY=sk_live_<B端自己的 Stripe 账号>
# STRIPE_WEBHOOK_SECRET=whsec_<B端自己的 Stripe webhook>

# ── 收款③ x402 轨（B端自己的收款钱包；a2a/period/batch 依赖） ──
X402_ENABLED=true
X402_PAY_TO=0x<B端自己的收款钱包地址>
X402_PRICE_WEI=1000000000000000        # 单价（wei）；示例 1e15 = 0.001 ETH，按业务定价
X402_CHAIN=oxachain

# ── 收款④ MPP 轨（可选；不配则 /payments/mpp/* 返回 503） ───────
# MPP_ENABLED=true
# MPP_DOMAIN=<EIP-712 domain>
# MPP_PAYEE=0x<B端自己的收款地址>
# MPP_CHAIN=oxachain
# MPP_SETTLE_THRESHOLD_WEI=<自动结算阈值 wei>
# MPP_SETTLE_INTERVAL_SEC=<自动结算间隔秒>

# ── 账本内结算能力（可选；未启用端点返回 503） ──────────────────
INVITE_ENABLED=true        # invite 收费邀请（agent 自动向 payer 发账单）
TRANSFER_ENABLED=true      # transfer 账本内原子划转（需内置 transaction runner）
BATCH_ENABLED=true         # batch 一次性建 N 个 a2a 收款意图
# ⚠️ batch 启用条件 = BATCH_ENABLED + 收款③ x402 + 收款① chain + a2a（A2A_ENABLED 默认 true）
#    缺任一 → GET /payments/capabilities 显示 batch { enabled: false }，/payments/batch 503
# PERIOD_ENABLED=true      # period 授权周期扣费（需收款③ x402）
# A2A_ENABLED=true         # 默认 true；如需显式关闭设 false

# ── 可选：事件出站转发（业务方回调端点；逗号分隔多目标） ─────────
# WEBHOOK_FORWARD_URL=https://your-service.example.com/payments/events
# WEBHOOK_FORWARD_SECRET=<HMAC 签名密钥（X-Payments-Signature）>
