# ============================================================
# InfraX Doc Service Configuration
# ============================================================

# ── LLM (Entity Extraction only, not answer generation) ──
LLM_BINDING=openai
LLM_BINDING_HOST=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_BINDING_API_KEY=YOUR_DEEPSEEK_API_KEY
LLM_TIMEOUT=120

# ── Embedding ──
# Backend: local (free, ~80MB model) or dashscope (cloud API, better Chinese)
EMBEDDING_BACKEND=local
# -- local backend --
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMS=384
# -- dashscope backend --
# EMBEDDING_BACKEND=dashscope
# EMBEDDING_MODEL=text-embedding-v3
# EMBEDDING_DIMS=1024
# EMBEDDING_API_KEY=YOUR_DASHSCOPE_API_KEY
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_TIMEOUT=60

# ── Storage Modes ──
# Options: local (JSON files), postgres (PGVector + PGGraph + PGKV)
STORAGE_MODE=local
WORKING_DIR=./data

# Postgres (only when STORAGE_MODE=postgres)
# PG_HOST=localhost
# PG_PORT=5432
# PG_USER=doc
# PG_PASSWORD=
# PG_DATABASE=doc
# DOC_KV_STORAGE=PGKVStorage
# DOC_VECTOR_STORAGE=PGVectorStorage
# DOC_GRAPH_STORAGE=PGGraphStorage
# DOC_STATUS_STORAGE=PGDocStatusStorage

# ── RAG Parameters ──
MAX_ASYNC=4
MAX_PARALLEL_INSERT=2
CHUNK_TOKEN_SIZE=1200
CHUNK_OVERLAP_TOKEN_SIZE=100
TOP_K=60
CHUNK_TOP_K=20
SUMMARY_LANGUAGE=Chinese

# ── Server ──
REST_HOST=0.0.0.0
REST_PORT=9721
MCP_ENABLED=true
ADMIN_API_KEY=YOUR_ADMIN_KEY

# Internal API key for aiservicer bridge (optional)
# Must match the DOC_API_KEY in shared/config.cjs
# DOC_API_KEY=aiservicer-doc-internal-key-2026
# (backward compat: LIGHTRAG_API_KEY also works)

# ── Tenant DB (SQLite for API key management) ──
TENANT_DB_PATH=./tenants/tenants.db

# ── Logging ──
LOG_LEVEL=INFO
