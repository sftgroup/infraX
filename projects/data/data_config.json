{
  "_comment": "Data Service — 数据采集配置。修改后需重启服务生效。",

  "kline": {
    "_comment": "symbols/timeframes/exchange/fetch_limit 由 .env (KL_* 变量) 控制，此处仅供文档参考。indicators 参数由此处读取。",
    "symbols": ["BTC/USDT", "ETH/USDT", "SOL/USDT"],
    "timeframes": ["1m", "5m", "15m", "1h", "4h", "1d"],
    "exchange": "binance",
    "fetch_limit": 500,
    "indicators": {
      "_comment": "技术指标计算参数。修改后重启生效。",
      "rsi": {"period": 14},
      "macd": {"fast": 12, "slow": 26, "signal": 9},
      "bollinger": {"window": 20, "num_std": 2},
      "atr": {"period": 14},
      "sma": {"windows": [5, 10, 20]}
    }
  },

  "crypto": {
    "coingecko_ids": {
      "bitcoin":      "BTC",
      "ethereum":     "ETH",
      "binancecoin":  "BNB",
      "solana":       "SOL",
      "ripple":       "XRP"
    }
