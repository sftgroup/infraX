# Data Service — 统一配置文件
# 复制为 .env 并修改实际值。不要提交 .env 到 git。

# ── 服务 ────────────────────────────────────────────────
DATA_SERVICE_PORT=9112
LOG_LEVEL=INFO

# ── 管理后台鉴权（GET/PUT /admin/config 需 Bearer ADMIN_API_KEY）────
# ADMIN_API_KEY=change-me

# ── 业务端点鉴权（/bars /factors/* /snapshots /stats）────────────
# 要求 Authorization: Bearer 或 X-API-Key 匹配；不配置则保持开放。
# 回退链：DATA_API_KEY → RAGSERVICER_API_KEY → DOC_API_KEY → LIGHTRAG_API_KEY
# （建议与 knowledge-injector 用同一把 RAGSERVICER_API_KEY，便于服务间联动）
# DATA_API_KEY=

# ── SQLite 数据存储 ─────────────────────────────────────
DATA_DB_PATH=data/data.db

# ── K线采集 (ccxt binance, 公开API无需密钥) ────────────
KL_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
KL_TIMEFRAMES=1m
KL_FETCH_LIMIT=500
KL_INTERVAL_SEC=300
KL_EXCHANGE=binance

# ── 数据采集配置（代币列表/指数/链上/DeFi/宏观/财报） ──
DATA_CONFIG_PATH=data_config.json
FACTOR_COLLECT_INTERVAL_SEC=300

# ── 财经日历采集 (需配置 CALENDAR_SOURCE) ────────────────
# CALENDAR_COLLECT_INTERVAL_SEC=600
# CALENDAR_SOURCE=https://your-api.com/events

# ── LightRAG 知识图谱 (注入用，暂未启用) ────────────────
# LIGHTRAG_URL=http://43.133.37.213:3610

# ── 外部 API 密钥 (可选，用于外部因子采集；多 key 用逗号分隔，采集时轮询) ──
# 可通过管理后台「Data Stack → 数据源 API Key」热更新，无需重启。
# FRED_API_KEY=            # FRED 宏观指标（CPI/PCE/NFP/GDP/联邦基金利率）
# NEWSAPI_API_KEY=         # 新闻采集（未配置则新闻禁用）
# ADANOS_API_KEY=          # Adanos 多源情绪（未配置则 fail-open）
# FINNHUB_API_KEY=         # 财经日历（未配置则回退静态 FOMC）/ 财报 earnings
# TIINGO_API_KEY=          # 外汇/期货/贵金属备源
# TWELVE_DATA_API_KEY=     # 外汇 K线主源（配置后优先于 yfinance）
# ALPHA_VANTAGE_KEY=       # 预留
# COINGECKO_API_KEY=       # CoinGecko（免费额度已够，可选）
# CRYPTOCOMPARE_API_KEY=   # 预留

# ── 外部因子扩展（追加到内置 18 个因子之后）───────────
# FACTORS_CONFIG_PATH=factors.json

# ── FinBERT 本地文本情绪（可选，P1a）─────────────────
# 对已采集新闻做真实 NLP 分类，聚合写 raw_snapshots
# (provider=sentiment, data_type=finbert_sentiment)，不影响现有 sentiment_score。
# 启用需部署机安装 transformers + torch（见 requirements.txt ML 段）。
# FINBERT_ENABLED=true
# FINBERT_MODEL=ProsusAI/finbert     # 可换 yiyanghkust/finbert-tone（支持中英）
# FINBERT_COLLECT_INTERVAL_SEC=1800

# ── Tree ML LightGBM 方向预测（可选，P1）─────────────
# 用 kline 表日线历史训练方向三分类（up/flat/down），输出机会评分+波动率档位，
# 写 raw_snapshots (provider=ml, data_type=tree_predictions)。
# 纯 CPU 训练（2C4G 秒级），启用需部署机安装 lightgbm（见 requirements.txt Tree ML 段）。
# TREE_ML_ENABLED=true
# TREE_ML_HORIZON=7                 # 标签：未来 N 日收益
# TREE_ML_UP_THR=0.01               # >+1% up / <-1% down / 其余 flat
# TREE_ML_MIN_SAMPLES=300           # 总样本不足则跳过训练
# TREE_ML_MIN_BARS=120              # 单 symbol 最少日线根数
# TREE_ML_COLLECT_INTERVAL_SEC=1800 # 预测/检查周期
# TREE_ML_RETRAIN_HOURS=24          # 重训周期
# TREE_ML_MODEL_DIR=models/         # 模型文件目录（git 忽略）

# ── 缓存 / Redis (Data Service 默认只用内存缓存) ─────────
# CACHE_ENABLED=false
# REDIS_URL=
