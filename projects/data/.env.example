# Data Service — 统一配置文件
# 复制为 .env 并修改实际值。不要提交 .env 到 git。

# ── 服务 ────────────────────────────────────────────────
DATA_SERVICE_PORT=9112
LOG_LEVEL=INFO

# ── 管理后台鉴权（GET/PUT /admin/config 需 Bearer ADMIN_API_KEY）────
# ADMIN_API_KEY=change-me

# ── 业务端点鉴权（/bars /factors/* /snapshots /stats）────────────
# 要求 Authorization: Bearer 或 X-API-Key 匹配；不配置则保持开放。
# 回退链：DATA_API_KEY → RAGSERVICER_API_KEY → DOC_API_KEY → LIGHTRAG_API_KEY
# （建议与 knowledge-injector 用同一把 RAGSERVICER_API_KEY，便于服务间联动）
# DATA_API_KEY=

# ── SQLite 数据存储 ─────────────────────────────────────
DATA_DB_PATH=data/data.db

# ── K线采集 (ccxt binance, 公开API无需密钥) ────────────
KL_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
KL_TIMEFRAMES=1m
# 历史深度回填目标（天），JSON 覆盖默认表（1m≥30d、5m/15m/30m≥180d、1h/4h≥365d、1d≥1095d）
# KL_BACKFILL_DAYS={"1m":30,"1d":1095}
KL_FETCH_LIMIT=500
KL_INTERVAL_SEC=300
# 多市场（美股/外汇/期货/A股/港股）独立采集周期：仅 1d 日线 + Twelve Data
# 免费 tier 限流（8 次/分钟 ~800 credits/天），默认 30 分钟（约 96 次/天）
KL_MULTI_INTERVAL_SEC=1800
KL_EXCHANGE=binance

# ── swap 永续合约采集（DS-8，需与 /bars?market_type=swap 配套）──
# 存储键 base/quote:quote（BTC/USDT:USDT），独立开关/标的/周期，不干扰 spot
KL_SWAP_ENABLED=false
KL_SWAP_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
# swap 周期建议与 KL_TIMEFRAMES 对齐（DS-8 契约：market_type=swap 各周期可查）
KL_SWAP_TIMEFRAMES=1m,5m,15m,30m,1h,4h,1d

# ── 数据采集配置（代币列表/指数/链上/DeFi/宏观/财报） ──
DATA_CONFIG_PATH=data_config.json
FACTOR_COLLECT_INTERVAL_SEC=300

# ── 财经日历采集 (需配置 CALENDAR_SOURCE) ────────────────
# CALENDAR_COLLECT_INTERVAL_SEC=600
# CALENDAR_SOURCE=https://your-api.com/events

# ── LightRAG 知识图谱 (注入用，暂未启用) ────────────────
# LIGHTRAG_URL=http://43.133.37.213:3610

# ── 外部 API 密钥 (可选，用于外部因子采集；多 key 用逗号分隔，采集时轮询) ──
# 可通过管理后台「Data Stack → 数据源 API Key」热更新，无需重启。
# FRED_API_KEY=            # FRED 宏观指标（CPI/PCE/NFP/GDP/联邦基金利率）
# NEWSAPI_API_KEY=         # 新闻采集（未配置则新闻禁用）
# ADANOS_API_KEY=          # Adanos 多源情绪（未配置则 fail-open）
# FINNHUB_API_KEY=<your key>  # 美股 quote/日线备选/财报 earnings/公司档案/情绪（经济日历 free tier 无权限）
# FIRECRAWL_API_KEY=<your key>  # 统一搜索服务（macro_news 新闻搜索补充；search API）
# TIINGO_API_KEY=          # 外汇/期货/贵金属备源
# TWELVE_DATA_API_KEY=     # 外汇 K线主源（配置后优先于 yfinance）
# ALPHA_VANTAGE_KEY=       # DXY 美元指数备源
# COINGECKO_API_KEY=       # CoinGecko demo key（heatmap/价格请求自动携带，提升限流）
# CRYPTOCOMPARE_API_KEY=   # 预留
# TUSHARE_TOKEN=           # Tushare A股日线（POST+token，需积分≥2000；未配置/无权限时回退腾讯/akshare）

# ── 外部因子扩展（追加到内置 18 个因子之后）───────────
# FACTORS_CONFIG_PATH=factors.json

# ── ML 推理联动（模型拆分到独立 ml-service）───────────
# LightGBM 方向预测（tree_predictions 快照）与 FinBERT 文本情绪
# （finbert_sentiment 快照）均由独立 ml-service 推理，本服务只拉取落库。
# 未配置 ML_SERVICE_URL 时两个 collector 空转（fail-silent）。
# ML_SERVICE_URL=http://<ml-server>:9120
# ML_API_KEY=                 # ml-service 自身鉴权（若配置了则必填）

# ── P2 单模型快照落库（§5.7）───
# 30min 拉 bolt/moirai/timesfm 预测 → ml_predictions 明细表，历史可查 /ml/predictions
P2_COLLECT_ENABLED=true
P2_COLLECT_INTERVAL_SEC=1800
P2_RETENTION_DAYS=90

# ── 旧栈 collector 合并（rawdata 位点 + OKX ChainOS 行情）───
# COLLECTOR_URL 为旧栈 collector 服务（Express :9101），需配 COLLECTOR_API_KEY
# （旧栈 api_keys 表签发的只读 key，X-API-Key header，非 Bearer）
# COLLECTOR_URL=http://43.156.99.215:9101
# COLLECTOR_API_KEY=pkx_xxxx
# 链上扫描位点聚合快照：每链已扫高度/事件数/状态/最近抓取时间 → onchain_checkpoints
ONCHAIN_COLLECT_ENABLED=true
ONCHAIN_COLLECT_INTERVAL_SEC=60
# OKX ChainOS 行情快照：hot-tokens（每链热门代币）+ index-prices（头部代币指数价）
# → okx_hot_tokens / okx_index_prices（web3.okx.com 官方 v6）
OKX_CHAINOS_COLLECT_ENABLED=true
OKX_CHAINOS_COLLECT_INTERVAL_SEC=60
OKX_CHAINS=1,56,8453        # 链 ID：Ethereum=1, BSC=56, Base=8453
OKX_HOT_LIMIT=10            # 每链热门代币数
OKX_INDEX_TOKENS=3          # 每链补指数价格的头部代币数

# ── 缓存 / Redis (Data Service 默认只用内存缓存) ─────────
# CACHE_ENABLED=false
# REDIS_URL=
