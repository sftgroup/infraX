# ============================================================
# InfraX RAGservicer Configuration
# ============================================================

# ── LLM (Entity Extraction only, not answer generation) ──
LLM_BINDING=openai
LLM_BINDING_HOST=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_BINDING_API_KEY=YOUR_DEEPSEEK_API_KEY
LLM_TIMEOUT=120

# ── Embedding ──
# Platform default: Qwen embedding via DashScope cloud API (no local model downloads).
# Backend options: dashscope (cloud, recommended) or local (requires installing
# sentence-transformers and will download a model from HuggingFace).
EMBEDDING_BACKEND=dashscope
# -- dashscope backend (default) --
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMS=1024
EMBEDDING_API_KEY=YOUR_DASHSCOPE_API_KEY
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# -- local backend (optional, downloads model) --
# EMBEDDING_BACKEND=local
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# EMBEDDING_DIMS=384
EMBEDDING_TIMEOUT=60

# ── Storage Modes ──
# Options: local (JSON files), postgres (PGVector + PGGraph + PGKV)
STORAGE_MODE=local
WORKING_DIR=./data

# Postgres (only when STORAGE_MODE=postgres)
# PG_HOST=localhost
# PG_PORT=5432
# PG_USER=ragservicer
# PG_PASSWORD=
# PG_DATABASE=ragservicer
# RAGSERVICER_KV_STORAGE=PGKVStorage
# RAGSERVICER_VECTOR_STORAGE=PGVectorStorage
# RAGSERVICER_GRAPH_STORAGE=PGGraphStorage
# RAGSERVICER_DOC_STATUS_STORAGE=PGDocStatusStorage

# ── RAG Parameters ──
MAX_ASYNC=4
MAX_PARALLEL_INSERT=2
CHUNK_TOKEN_SIZE=1200
CHUNK_OVERLAP_TOKEN_SIZE=100
TOP_K=60
CHUNK_TOP_K=20
SUMMARY_LANGUAGE=Chinese

# ── Server ──
REST_HOST=0.0.0.0
REST_PORT=9721
MCP_ENABLED=true
ADMIN_API_KEY=YOUR_ADMIN_KEY

# Internal API key for aiservicer bridge (optional)
# Must match the RAGSERVICER_API_KEY in shared/config.cjs
# RAGSERVICER_API_KEY=aiservicer-ragservicer-internal-key-2026
# (backward compat: DOC_API_KEY / LIGHTRAG_API_KEY also work)

# ── Tenant DB (SQLite for API key management) ──
TENANT_DB_PATH=./tenants/tenants.db
# RWL-1: SQLite 写锁等待时长（ms）。短锁冲突自动等待而非抛 database is locked。
TENANT_BUSY_TIMEOUT_MS=30000
# RWL-3: 审计日志 / last_used_at 写锁等待时长（ms）——短超时快速降级，
# 避免 after_request 审计写被长事务持锁拖慢所有请求（晚间 10s 慢响应根因）。
TENANT_AUDIT_BUSY_TIMEOUT_MS=1000

# ── Logging ──
LOG_LEVEL=INFO
