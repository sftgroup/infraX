# chain-rpc 配置示例（复制为 .env 并按需修改）

# ── 服务 ─────────────────────────────────────────────
PORT=9130
NODE_ENV=production
LOG_LEVEL=info

# ── 鉴权分级（必填；留空 = 该端点开放，生产必须配置） ──
CHAIN_RPC_READ_KEY=
CHAIN_RPC_BROADCAST_KEY=

# ── 可选：data 服务统一签发 key 校验（dx_/mx_ 等） ─────
# 开启后读/广播端点支持 data /api-keys/verify（scope=rpc / rpc_broadcast）
CHAIN_RPC_ENABLE_EXTERNAL_VERIFY=false
DATA_SERVICE_URL=http://127.0.0.1:9112
DATA_API_KEY=

# ── RPC 端点池 ───────────────────────────────────────
# 链白名单（逗号分隔）
CHAIN_RPC_CHAINS=sepolia,ethereum,bsc,base,oxa,solana
# 每链 URL（可选追加；rpc-pool.json 已有基线）
#SEPOLIA_RPC_URL=
#ETH_RPC_URL=
#BSC_RPC_URL=
#BASE_RPC_URL=
#OXA_RPC_URL=
#SOLANA_RPC_URL=
# 全量覆盖（JSON，优先级最高）：INFRAX_RPC_POOL='{"ethereum":[...]}'

# ── 广播确认轮询 ─────────────────────────────────────
CHAIN_RPC_WAIT_SEC=30
CHAIN_RPC_WAIT_INTERVAL_MS=3000

# ── MQ-16 T-3：RPC 读套餐订阅计费 ─────────────────────
# 订阅/用量数据独立库（rpc_keys / rpc_usage / rpc_usage_daily 自举）
CHAIN_RPC_DATABASE_URL=postgresql://ubuntu@localhost:5432/pocketx_chainrpc
# 通用支付引擎（infrax-payments :9132）
PAYMENTS_URL=http://127.0.0.1:9132
PAYMENTS_API_KEY=
PAYMENTS_WEBHOOK_SECRET=
# 默认支付 rail：chain / fiat / x402
PAYMENTS_DEFAULT_RAIL=chain
PAYMENTS_CHAIN=oxachain
PAYMENTS_FIAT_PERIOD=month
# 套餐 planId 链上映射（SubscriptionManager.getPlan id）：rpc_pro=5 / rpc_enterprise=6
PAYMENTS_PLAN_ID_MAP={"rpc_pro":5,"rpc_enterprise":6}
# 前端回调跳转 origin（fiat checkout success/cancel URL）
#CORS_ORIGIN=http://localhost:9111
