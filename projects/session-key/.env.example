# ===== Service Config =====
PORT=3500
NODE_ENV=production

# ===== Database =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=session_key_engine
DB_USER=postgres
DB_PASSWORD=change-me

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
