# MPC Wallet 服务配置示例（复制为 .env 并按需修改）

# ── 服务 ─────────────────────────────────────────────
PORT=6003
MPC_ENCRYPTION_SECRET=change-me-in-production
# 统一平台鉴权（本地 bridge key，Bearer / X-API-Key / X-Service-Key）
MPC_API_KEY=
# 可选：data 服务统一签发 key 校验（mp_ key，scope=mpc）
DATA_URL=http://127.0.0.1:9112
DATA_API_KEY=

# ── 数据库 ───────────────────────────────────────────
DATABASE_URL=postgresql://ubuntu@localhost:5432/pocketx_mpc

# ── 链访问（统一经 chain-rpc 网关，DC-3） ─────────────
CHAIN_RPC_URL=http://127.0.0.1:9130
CHAIN_RPC_READ_KEY=
CHAIN_RPC_BROADCAST_KEY=

# ── TSS 签名器（M3/E-4：cggmp24 2-of-2） ──────────────
MPC_SIGNER_URL=http://127.0.0.1:9201
TSS_SIGNER_URL=http://127.0.0.1:9200

# ── Agent 限额（空 = 不限制，向后兼容） ────────────────
MPC_AGENT_TX_LIMIT_ETH=0.1
MPC_AGENT_ERC20_LIMIT=1000
MPC_CONTRACT_WHITELIST=
MPC_APPROVE_WHITELIST=
MPC_TRANSFER_WHITELIST=
MPC_SESSION_TTL_MS=1800000

# ── SMTP 验证码（未配置回退日志） ─────────────────────
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=InfraX
MAIL_FROM=noreply@infrax.ai

# ── MQ-16 T-4：按量计费（签名/转账按次从引擎 ledger 余额扣费） ──
# 未配置这三项 = 免费放行（开发环境）；生产必须全部配置。
# 通用支付引擎（infrax-payments :9132；需开启 TRANSFER_ENABLED=true）
MPC_PAYMENTS_URL=http://127.0.0.1:9132
MPC_PAYMENTS_API_KEY=
# 收费收款账户（引擎 ledger 收款方；建议与引擎 X402_PAY_TO 一致）
MPC_PLATFORM_ADDRESS=
# 按次单价（wei，原生资产；默认 sign=0.0001 / tx=0.001）
MPC_SIGN_FEE_WEI=100000000000000
MPC_TX_FEE_WEI=1000000000000000
